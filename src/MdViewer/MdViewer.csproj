<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icono del .exe en Windows (Explorador, barra de tareas) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>MD Viewer</Product>
    <Authors>CAEBB</Authors>
    <!-- La sube automáticamente cada tarea "Instalador: ..." (tools/subir-version.*) -->
    <Version>1.3</Version>
    <!-- Al publicar, precompila a código nativo: el arranque pasa de ~1,5 s a ~0,7 s (el .exe crece ~50 MB) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Versión limpia ("1.3") en las propiedades del .exe, sin el hash del commit que agrega el SDK -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Recursos usados en tiempo de ejecución -->
    <AvaloniaResource Include="Assets\app.ico" />
    <AvaloniaResource Include="Assets\autor.png" />
    <AvaloniaResource Include="Assets\mdfile.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fecha de publicación que muestra "Acerca de" (la de la compilación) -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$([System.DateTime]::Now.ToString("yyyy-MM-dd"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.2.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent2" Version="12.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdown.Avalonia" Version="12.0.2" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.5" />
  </ItemGroup>
</Project>
