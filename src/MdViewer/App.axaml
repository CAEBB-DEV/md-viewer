<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MdViewer.App"
             RequestedThemeVariant="Default">
             <!-- "Default" sigue el tema del sistema; el botón ◐ lo cambia a Light/Dark. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- LineBrush: líneas finas de bordes y separadores (Fluent2 no trae un recurso equivalente).
                     ViewerSelectionBrush: selección de texto en el visor.
                     ModifiedBrush: archivo con cambios sin guardar en "Archivos" (ámbar "attention" de GitHub). -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LineBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="ViewerSelectionBrush" Color="#4D0969DA" />
                    <SolidColorBrush x:Key="ModifiedBrush" Color="#9A6700" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LineBrush" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ViewerSelectionBrush" Color="#664493F8" />
                    <SolidColorBrush x:Key="ModifiedBrush" Color="#D29922" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <Fluent2Theme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <!-- Cursor de enlace (mano) en todos los botones (también los de alternar, como Editar) y en las filas del explorador -->
        <Style Selector=":is(Button), TreeViewItem">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Styles>
</Application>
