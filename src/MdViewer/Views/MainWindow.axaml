<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MdViewer.ViewModels"
        xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
        xmlns:sh="clr-namespace:Markdown.Avalonia.SyntaxHigh.StyleCollections;assembly=Markdown.Avalonia.SyntaxHigh"
        xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="MdViewer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app.ico"
        Title="MD Viewer"
        Width="1100" Height="720" MinWidth="360" MinHeight="300"
        WindowState="Maximized">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Visor y editor: barra de desplazamiento siempre visible, en el borde de la ventana -->
        <Style Selector="md|MarkdownScrollViewer ScrollViewer, ae|TextEditor ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>

        <!-- Paneles con borde fino: Archivos, Carpetas, panel principal y barra de ancho -->
        <Style Selector="Border.panel">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- Encabezado de sección del explorador (título + botones compactos) -->
        <!-- Barra superior: botones cuadrados con icono de trazo (atenuado cuando el botón está deshabilitado) -->
        <Style Selector="StackPanel.toolbar > :is(Button)">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.toolbar Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        </Style>
        <Style Selector="StackPanel.toolbar > :is(Button):disabled Path">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="StackPanel.toolbar > ToggleButton:checked Path">
            <Setter Property="Stroke" Value="{DynamicResource ToggleButtonForegroundChecked}" />
        </Style>

        <!-- Clic en cualquier parte del encabezado (fuera de los botones) minimiza/expande el panel -->
        <Style Selector="Grid.sectionHeader">
            <Setter Property="Margin" Value="10,6,6,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Grid.sectionHeader Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <!-- Flecha ▾ del encabezado (solo el icono; el clic lo atiende todo el encabezado) -->
        <Style Selector="Path.chevron">
            <Setter Property="Data" Value="M2,4 L6,8 L10,4" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="1,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding $parent[Window].Foreground}" />
        </Style>
        <!-- Minimizado: la flecha apunta a la derecha -->
        <Style Selector="Path.chevron.collapsed">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
        </Style>
        <!-- Separador entre paneles: muestra el cursor de cambiar alto -->
        <Style Selector="GridSplitter">
            <Setter Property="MinHeight" Value="6" />
        </Style>

        <!-- Árboles del explorador: misma plantilla y expansión perezosa.
             Cada fila ocupa todo el ancho: un clic en una carpeta la despliega/pliega y los elementos de
             primer nivel muestran un botón ✕ al pasar el mouse. -->
        <Style Selector="TreeView.explorer">
            <Setter Property="ItemTemplate">
                <TreeDataTemplate x:DataType="vm:FsNode" ItemsSource="{Binding Children}">
                    <Grid Classes="row" Classes.dirty="{Binding IsDirty}" ColumnDefinitions="Auto,Auto,*,Auto" Background="Transparent"
                          Tapped="ExplorerRowTapped" DoubleTapped="ExplorerRowDoubleTapped">
                        <!-- Con cambios sin guardar: ● a la izquierda del icono (solo en Archivos) -->
                        <TextBlock Classes="dirtyDot" Text="●" />
                        <!-- Icono: el mismo de los .md en el sistema (hoja + logo) para archivos; carpeta para carpetas -->
                        <Image Grid.Column="1" Source="/Assets/mdfile.png" Width="18" Height="18" Margin="0,0,6,0"
                               RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding !IsFolder}" />
                        <TextBlock Grid.Column="1" Text="📁" Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="{Binding IsFolder}" />
                        <TextBlock Grid.Column="2" Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding FullPath}" />
                        <Button Grid.Column="3" Classes="rowClose" IsVisible="{Binding IsRoot}"
                                Command="{Binding $parent[TreeView].((vm:MainViewModel)DataContext).CloseItemCommand}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Name, StringFormat='Cerrar {0}'}"
                                ToolTip.Tip="Cerrar (no borra nada del disco)">
                            <Path Data="M2,2 L10,10 M10,2 L2,10" Width="12" Height="12" StrokeThickness="1.6"
                                  StrokeLineCap="Round" Stroke="{Binding $parent[Button].Foreground}" />
                        </Button>
                    </Grid>
                </TreeDataTemplate>
            </Setter>
        </Style>
        <Style Selector="TreeView.explorer TreeViewItem" x:DataType="vm:FsNode">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
        <Style Selector="TreeView.explorer TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.rowClose">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Grid.row:pointerover Button.rowClose">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Archivo con cambios sin guardar: ● a la izquierda y nombre en ámbar (solo en Archivos). Archivos no tiene
             carpetas, así que su fila no reserva el hueco de la flecha ▸ (32 px): en su lugar queda solo el del ●,
             transparente si no hay cambios (los iconos quedan alineados). -->
        <Style Selector="TreeView.files TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TextBlock.dirtyDot">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="11" />
            <Setter Property="Margin" Value="6,0,5,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>
        <Style Selector="TreeView.files TextBlock.dirtyDot">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="TreeView.files Grid.row.dirty TextBlock.dirtyDot">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Grid.row.dirty TextBlock.name">
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>
        <!-- Mensaje central sin documento: texto atenuado y atajos como teclas (recuadro con borde inferior más grueso) -->
        <Style Selector="WrapPanel.shortcutHint > TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="WrapPanel.shortcutHint > TextBlock.plus">
            <Setter Property="Margin" Value="3,3" />
        </Style>
        <Style Selector="WrapPanel.shortcutHint > TextBlock.comma">
            <Setter Property="Margin" Value="0,3,2,3" />
        </Style>
        <Style Selector="Border.key">
            <Setter Property="Background" Value="{DynamicResource KeyCapBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.key > TextBlock">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Botón "Abrir" del encabezado de Archivos: icono de carpeta abierta -->
        <Style Selector="Grid.sectionHeader Button.iconButton">
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="Grid.sectionHeader Button.iconButton Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Barra superior -->
        <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource LineBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Content="☰" Click="TogglePane" ToolTip.Tip="Mostrar/ocultar explorador" />
                <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                           Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <!-- Solo iconos: editar, guardar, cerrar documento, tema y acerca de -->
                <StackPanel Grid.Column="2" Classes="toolbar" Orientation="Horizontal" Spacing="6">
                    <ToggleButton IsChecked="{Binding IsEditing}" ToolTip.Tip="Editar" AutomationProperties.Name="Editar"
                                  IsEnabled="{Binding FileName, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Path Data="M10.5,2.5 L13.5,5.5 L5.5,13.5 L2.5,13.5 L2.5,10.5 Z M8.5,4.5 L11.5,7.5" />
                    </ToggleButton>
                    <Button Command="{Binding SaveCommand}" ToolTip.Tip="Guardar (Ctrl+S)" AutomationProperties.Name="Guardar">
                        <Path Data="M2.5,2.5 H11 L13.5,5 V13.5 H2.5 Z M5,2.5 V6 H10 V2.5 M5,13.5 V9.5 H11 V13.5" />
                    </Button>
                    <Button Command="{Binding CloseViewCommand}" ToolTip.Tip="Cerrar documento"
                            AutomationProperties.Name="Cerrar documento"
                            IsEnabled="{Binding FileName, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Path Data="M4,4 L12,12 M12,4 L4,12" />
                    </Button>
                    <Button Click="ToggleTheme" ToolTip.Tip="Tema claro/oscuro" AutomationProperties.Name="Tema claro/oscuro">
                        <!-- Círculo con la mitad derecha rellena -->
                        <Panel>
                            <Path Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z" />
                            <Path Data="M8,1.5 A6.5,6.5 0 0 1 8,14.5 Z" Fill="{Binding $parent[Button].Foreground}" />
                        </Panel>
                    </Button>
                    <Button Click="ShowAbout" ToolTip.Tip="Acerca de" AutomationProperties.Name="Acerca de">
                        <!-- Círculo con una "i" -->
                        <Path Data="M8,1.25 A6.75,6.75 0 1 1 7.99,1.25 Z M8,7.2 V11.6 M8,4.6 V4.7" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mensaje de error -->
        <TextBlock DockPanel.Dock="Top" Padding="12,6" Foreground="#E5484D" TextWrapping="Wrap"
                   Text="{Binding Error}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <SplitView Name="Split" IsPaneOpen="True" DisplayMode="Inline" OpenPaneLength="400"
                   PaneBackground="{Binding $parent[Window].Background}">
            <SplitView.Pane>
              <Grid ColumnDefinitions="*,Auto">
                <!-- Explorador: Archivos (abiertos) arriba y Carpetas abajo (50 % al inicio). El separador cambia el alto;
                     Archivos siempre queda abierto y nunca tapa un archivo abierto (ver UpdateFilesMinHeight);
                     ▾ pliega Carpetas hasta dejar solo su encabezado (ver ApplyExplorerLayout). -->
                <Grid Name="ExplorerGrid" RowDefinitions="*,6,*" Margin="6,6,0,6">
                    <Border Classes="panel">
                        <DockPanel>
                            <Grid Name="FilesHeader" Classes="sectionHeader" DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Cursor="Arrow">
                                <TextBlock Text="Archivos" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <Button Grid.Column="1" Classes="iconButton" Click="CreateFile" AutomationProperties.Name="Crear archivo"
                                        ToolTip.Tip="Crear archivo (Ctrl+N)">
                                    <!-- Hoja con +: archivo nuevo -->
                                    <Path Data="M9,1.5 H3.5 A1,1 0 0 0 2.5,2.5 V13.5 A1,1 0 0 0 3.5,14.5 H8 M9,1.5 L12.5,5 V8 M9,1.5 V5 H12.5 M12,10 V15 M9.5,12.5 H14.5" />
                                </Button>
                                <Button Grid.Column="2" Classes="iconButton" Click="AddFile" AutomationProperties.Name="Abrir archivos"
                                        ToolTip.Tip="Abrir archivos (Ctrl+O)">
                                    <!-- Carpeta abierta -->
                                    <Path Data="M1.5,12.5 V3.5 A1,1 0 0 1 2.5,2.5 H6 L7.5,4.5 H12.5 A1,1 0 0 1 13.5,5.5 V7 M1.5,12.5 L3.5,7.5 A1,1 0 0 1 4.4,7 H14.2 A0.6,0.6 0 0 1 14.8,7.8 L13,12.1 A0.8,0.8 0 0 1 12.3,12.5 Z" />
                                </Button>
                            </Grid>
                            <Panel Name="FilesBody">
                                <TextBlock Name="FilesHint" Text="Aquí aparecen los archivos abiertos. Crea o abre archivos con los botones de arriba, o con doble clic en Carpetas."
                                           TextWrapping="Wrap" Margin="12,4" Opacity="0.6" IsVisible="{Binding !Files.Count}" />
                                <TreeView Name="FilesTree" Classes="explorer files" ItemsSource="{Binding Files}"
                                          SelectedItem="{Binding SelectedFile}"
                                          SelectionChanged="ExplorerSelectionChanged">
                                    <TreeView.KeyBindings>
                                        <KeyBinding Gesture="Delete" Command="{Binding CloseItemCommand}" CommandParameter="{Binding SelectedFile}" />
                                    </TreeView.KeyBindings>
                                </TreeView>
                            </Panel>
                        </DockPanel>
                    </Border>

                    <!-- Separador arrastrable entre los dos paneles -->
                    <GridSplitter Name="ExplorerSplitter" Grid.Row="1" ResizeDirection="Rows" Background="Transparent" />

                    <Border Grid.Row="2" Classes="panel">
                        <DockPanel>
                            <Grid Classes="sectionHeader" DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Tapped="FoldersHeaderTapped">
                                <Path Name="FoldersToggle" Classes="chevron" />
                                <TextBlock Grid.Column="1" Text="Carpetas" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="+" Click="AddFolder" AutomationProperties.Name="Agregar carpeta"
                                        ToolTip.Tip="Agregar carpetas" />
                            </Grid>
                            <Panel Name="FoldersBody">
                                <TextBlock Text="Agrega carpetas con +" TextWrapping="Wrap" Margin="12,4"
                                           Opacity="0.6" IsVisible="{Binding !Folders.Count}" />
                                <TreeView Classes="explorer" ItemsSource="{Binding Folders}"
                                          SelectedItem="{Binding SelectedFolderItem}"
                                          SelectionChanged="ExplorerSelectionChanged">
                                    <TreeView.KeyBindings>
                                        <KeyBinding Gesture="Delete" Command="{Binding CloseItemCommand}" CommandParameter="{Binding SelectedFolderItem}" />
                                    </TreeView.KeyBindings>
                                </TreeView>
                            </Panel>
                        </DockPanel>
                    </Border>
                </Grid>
                <!-- Borde arrastrable para cambiar el ancho del explorador -->
                <Thumb Grid.Column="1" Width="6" Cursor="SizeWestEast" Background="Transparent"
                       DragDelta="ResizePane">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Border Background="{TemplateBinding Background}" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
              </Grid>
            </SplitView.Pane>

            <!-- Contenido: el visor centra el texto; el editor usa todo el ancho -->
            <DockPanel Margin="0,6,6,6">
            <!-- Barra inferior: ancho de lectura. Solo en el área del visor y solo al visualizar un archivo -->
            <Border DockPanel.Dock="Bottom" Classes="panel" Margin="0,6,0,0" Padding="10,0"
                    IsVisible="{Binding IsViewing}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" TextElement.FontSize="11">
                    <TextBlock Text="Ancho de lectura" VerticalAlignment="Center" Opacity="0.7" />
                    <!-- Slider de Fluent a escala 0,75 para que la barra quede baja sin recortarlo -->
                    <LayoutTransformControl VerticalAlignment="Center">
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                        </LayoutTransformControl.LayoutTransform>
                        <Slider Name="WidthSlider" Width="190" Margin="0,-4"
                                Minimum="480" Maximum="2400" Value="1000" SmallChange="10" LargeChange="100"
                                ValueChanged="ViewerWidthChanged" />
                    </LayoutTransformControl>
                    <!-- Ancho escrito a mano: se aplica con Enter (Esc o salir sin Enter vuelve al valor actual) -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBox Name="WidthBox" Width="58" MinWidth="0" MinHeight="0" Padding="6,2" FontSize="11"
                                 HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Ancho de lectura en píxeles"
                                 ToolTip.Tip="Escribe el ancho (480–2400) y presiona Enter"
                                 KeyDown="WidthBoxKeyDown" LostFocus="WidthBoxLostFocus" />
                        <TextBlock Text="px" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="panel">
            <Panel>
                <Panel.Resources>
                    <x:Double x:Key="ScrollBarSize">18</x:Double>
                    <x:Double x:Key="ScrollBarThumbThickness">10</x:Double>
                </Panel.Resources>

                <!-- Sin documento abierto: logo y nombre de la app al centro -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                            IsVisible="{Binding FileName, Converter={x:Static ObjectConverters.IsNull}}">
                    <Image Source="/Assets/app.ico" Width="160" Height="160" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Text="MD Viewer" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <!-- Mensaje con los atajos dibujados como teclas (estilo WrapPanel.shortcutHint / Border.key) -->
                    <WrapPanel Classes="shortcutHint" HorizontalAlignment="Center">
                        <TextBlock Text="Crea" />
                        <Border Classes="key"><TextBlock Text="Ctrl" /></Border>
                        <TextBlock Classes="plus" Text="+" />
                        <Border Classes="key"><TextBlock Text="N" /></Border>
                        <TextBlock Classes="comma" Text="," />
                        <TextBlock Text="Abre" />
                        <Border Classes="key"><TextBlock Text="Ctrl" /></Border>
                        <TextBlock Classes="plus" Text="+" />
                        <Border Classes="key"><TextBlock Text="O" /></Border>
                        <TextBlock Classes="comma" Text="," />
                        <TextBlock Text="o Selecciona un Archivo para Iniciar a trabajar con Archivos MarkDown" TextWrapping="Wrap" />
                    </WrapPanel>
                </StackPanel>

                <md:MarkdownScrollViewer Name="Viewer" Markdown="{Binding NativeMarkdown}" AssetPathRoot="{Binding DocumentFolder}" SelectionEnabled="True"
                                         SelectionBrush="{DynamicResource ViewerSelectionBrush}"
                                         IsVisible="{Binding ShowNativeViewer}">
                    <!-- Estilo tipo GitHub (claro/oscuro) en lugar del estilo propio de la librería.
                         AppendixOfFluentTheme aporta el resaltado de sintaxis de los bloques de código. -->
                    <md:MarkdownScrollViewer.MarkdownStyle>
                        <Styles>
                            <sh:AppendixOfFluentTheme />
                            <StyleInclude Source="avares://MdViewer/Styles/GithubMarkdown.axaml" />
                        </Styles>
                    </md:MarkdownScrollViewer.MarkdownStyle>
                </md:MarkdownScrollViewer>

                <!-- Visor web: documentos con HTML (como en GitHub). El NativeWebView se crea aquí con el primer
                     documento que lo necesita (MainWindow.WebViewer); su visibilidad la controla UpdateWebViewer -->
                <Panel Name="WebHost" />

                <ae:TextEditor Name="Editor" Document="{Binding Document}" Padding="8,8,0,0"
                               ShowLineNumbers="True" WordWrap="True" FontSize="14"
                               FontFamily="Cascadia Code,Consolas,Menlo,DejaVu Sans Mono,monospace"
                               IsVisible="{Binding IsEditing}" />
            </Panel>
            </Border>
            </DockPanel>
        </SplitView>
    </DockPanel>
</Window>
